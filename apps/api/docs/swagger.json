                "responses": {
                    "200": { "description": "OK", "schema": { "$ref": "#/definitions/response.Response" } }
                }
            }
        },
        "/payments": {
            "post": {
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Payments"],
                "summary": "Initiate payment for an order",
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    { "in": "body", "name": "body", "required": true, "schema": { "$ref": "#/definitions/request.InitiatePaymentRequest" } }
                ],
                "responses": {
                    "201": { "description": "Created", "schema": { "$ref": "#/definitions/response.Response" } }
                }
            }
        },
        "/payments/callback": {
            "post": {
                "consumes": ["application/json"],
                "produces": ["application/json"],
                "tags": ["Payments"],
                "summary": "Handle Midtrans payment callback",
                "responses": {
                    "200": { "description": "OK", "schema": { "$ref": "#/definitions/response.Response" } }
                }
            }
        },
        "/payments/{id}/status": {
            "get": {
                "produces": ["application/json"],
                "tags": ["Payments"],
                "summary": "Check payment status",
                "security": [{ "BearerAuth": [] }],
                "parameters": [
                    { "in": "path", "name": "id", "type": "string", "required": true, "description": "Payment ID" }
                ],
                "responses": {
                    "200": { "description": "OK", "schema": { "$ref": "#/definitions/response.Response" } }
                }
            }
        }
    },
    "definitions": {
        "request.RegisterRequest": {
            "type": "object",
            "required": ["email", "password", "full_name"],
            "properties": {
                "email": { "type": "string", "example": "user@example.com" },
                "password": { "type": "string", "minLength": 8, "example": "securePass123" },
                "full_name": { "type": "string", "example": "John Doe" },
                "phone": { "type": "string", "example": "08123456789" },
                "role": { "type": "string", "enum": ["renter", "owner"], "example": "renter" }
            }
        },
        "request.LoginRequest": {
            "type": "object",
            "required": ["email", "password"],
            "properties": {
                "email": { "type": "string", "example": "user@example.com" },
                "password": { "type": "string", "example": "securePass123" }
            }
        },
        "request.GoogleLoginRequest": {
            "type": "object",
            "required": ["id_token"],
            "properties": {
                "id_token": { "type": "string", "example": "eyJhbGciOiJSUzI1NiIs..." }
            }
        },
        "request.RefreshTokenRequest": {
            "type": "object",
            "required": ["refresh_token"],
            "properties": {
                "refresh_token": { "type": "string" }
            }
        },
        "request.ForgotPasswordRequest": {
            "type": "object",
            "required": ["email"],
            "properties": {
                "email": { "type": "string", "example": "user@example.com" }
            }
        },
        "request.ResetPasswordRequest": {
            "type": "object",
            "required": ["token", "new_password"],
            "properties": {
                "token": { "type": "string" },
                "new_password": { "type": "string", "minLength": 8 }
            }
        },
        "request.CreateStoreRequest": {
            "type": "object",
            "required": ["name", "phone", "email", "address", "city", "province"],
            "properties": {
                "name": { "type": "string", "example": "Outdoor Gear Bandung" },
                "description": { "type": "string", "example": "Premium outdoor equipment rental" },
                "phone": { "type": "string", "example": "08123456789" },
                "email": { "type": "string", "example": "store@example.com" },
                "address": { "type": "string", "example": "Jl. Raya Dago No. 123" },
                "city": { "type": "string", "example": "Bandung" },
                "province": { "type": "string", "example": "Jawa Barat" },
                "postal_code": { "type": "string", "example": "40135" },
                "latitude": { "type": "number", "example": -6.8845 },
                "longitude": { "type": "number", "example": 107.6145 }
            }
        },
        "request.UpdateStoreRequest": {
            "type": "object",
            "properties": {
                "name": { "type": "string", "example": "Updated Store Name" },
                "description": { "type": "string" },
                "phone": { "type": "string" },
                "email": { "type": "string" },
                "address": { "type": "string" },
                "city": { "type": "string" },
                "province": { "type": "string" },
                "postal_code": { "type": "string" },
                "latitude": { "type": "number" },
                "longitude": { "type": "number" },
                "logo_url": { "type": "string" },
                "banner_url": { "type": "string" }
            }
        },
        "request.AddStorePhotoRequest": {
            "type": "object",
            "required": ["photo_url"],
            "properties": {
                "photo_url": { "type": "string", "example": "https://cdn.example.com/photo.jpg" },
                "caption": { "type": "string", "example": "Storefront view" },
                "sort_order": { "type": "integer", "example": 1 },
                "is_primary": { "type": "boolean", "example": false }
            }
        },
        "request.SetOperatingHoursRequest": {
            "type": "object",
            "required": ["hours"],
            "properties": {
                "hours": {
                    "type": "array",
                    "items": { "$ref": "#/definitions/request.OperatingHourItem" }
                }
            }
        },
        "request.OperatingHourItem": {
            "type": "object",
            "required": ["day_of_week", "open_time", "close_time"],
            "properties": {
                "day_of_week": { "type": "integer", "minimum": 1, "maximum": 7, "example": 1 },
                "open_time": { "type": "string", "example": "08:00" },
                "close_time": { "type": "string", "example": "17:00" },
                "is_closed": { "type": "boolean", "example": false }
            }
        },
        "request.SuspendStoreRequest": {
            "type": "object",
            "required": ["reason"],
            "properties": {
                "reason": { "type": "string", "example": "Violation of terms of service" }
            }
        },
        "request.CreateEquipmentRequest": {
            "type": "object",
            "required": ["category_id", "name", "total_stock", "condition"],
            "properties": {
                "category_id": { "type": "string" },
                "name": { "type": "string", "example": "Tenda Dome 4P" },
                "description": { "type": "string" },
                "brand": { "type": "string", "example": "Eiger" },
                "specifications": { "type": "string" },
                "total_stock": { "type": "integer", "example": 5 },
                "condition": { "type": "string", "enum": ["new", "good", "fair"], "example": "new" },
                "weight_grams": { "type": "integer" },
                "min_rental_days": { "type": "integer", "example": 1 },
                "max_rental_days": { "type": "integer", "example": 30 },
                "requires_deposit": { "type": "boolean" },
                "deposit_amount": { "type": "number" }
            }
        },
        "request.UpdateEquipmentRequest": {
            "type": "object",
            "properties": {
                "name": { "type": "string" },
                "description": { "type": "string" },
                "brand": { "type": "string" },
                "total_stock": { "type": "integer" },
                "condition": { "type": "string", "enum": ["new", "good", "fair"] },
                "min_rental_days": { "type": "integer" },
                "max_rental_days": { "type": "integer" },
                "deposit_amount": { "type": "number" },
                "is_active": { "type": "boolean" }
            }
        },
        "request.CheckAvailabilityRequest": {
            "type": "object",
            "required": ["start_date", "end_date"],
            "properties": {
                "start_date": { "type": "string", "example": "2026-07-01" },
                "end_date": { "type": "string", "example": "2026-07-03" },
                "quantity": { "type": "integer", "example": 1 }
            }
        },
        "request.CreateOrderRequest": {
            "type": "object",
            "required": ["store_id", "items", "rental_start_date", "rental_end_date", "pickup_method"],
            "properties": {
                "store_id": { "type": "string" },
                "items": { "type": "array", "items": { "$ref": "#/definitions/request.OrderItemRequest" } },
                "rental_start_date": { "type": "string", "example": "2026-07-01" },
                "rental_end_date": { "type": "string", "example": "2026-07-03" },
                "notes": { "type": "string" },
                "pickup_method": { "type": "string", "enum": ["pickup", "delivery"] },
                "delivery_address": { "type": "string" }
            }
        },
        "request.OrderItemRequest": {
            "type": "object",
            "required": ["equipment_id", "quantity"],
            "properties": {
                "equipment_id": { "type": "string" },
                "quantity": { "type": "integer", "minimum": 1 }
            }
        },
        "request.RejectOrderRequest": {
            "type": "object",
            "required": ["reason"],
            "properties": {
                "reason": { "type": "string" }
            }
        },
        "request.InitiatePaymentRequest": {
            "type": "object",
            "required": ["order_id"],
            "properties": {
                "order_id": { "type": "string" }
            }
        },
        "response.Response": {
            "type": "object",
            "properties": {
                "success": { "type": "boolean", "example": true },
                "message": { "type": "string", "example": "operation successful" },
                "data": { "type": "object" },
                "meta": { "type": "object" }
            }
        },
        "response.ErrorResponse": {
            "type": "object",
            "properties": {
                "success": { "type": "boolean", "example": false },
                "message": { "type": "string", "example": "error message" },
                "errors": { "type": "object" }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "JWT Authorization header using the Bearer scheme. Example: \"Bearer {token}\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}
